AETHER_ENV=production
AETHER_HOST=0.0.0.0
AETHER_PORT=8000
AETHER_CORS_ORIGINS=https://your-domain.example
AETHER_DATA_DIR=/app/data
AETHER_MODEL_CACHE=/app/model-cache
AETHER_MAX_UPLOAD_MB=100
AETHER_MAX_MODEL_PARAMS_MILLIONS=1500
AETHER_MAX_TRAINING_STEPS=5000
AETHER_MAX_SEQUENCE_LENGTH=1024
AETHER_MAX_ACTIVE_JOBS_PER_USER=1
AETHER_MAX_JOBS_PER_DAY=3
AETHER_JWT_SECRET=replace-with-long-random-secret
AETHER_JWT_EXP_MINUTES=1440
HF_TOKEN=
AETHER_DOMAIN=your-domain.example
